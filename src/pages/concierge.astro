---
import Base from '../layouts/Base.astro';
import { href } from '../lib/url';
import site from '../data/site.json';

const concierge = site.concierge;
const callHref = concierge.phone ? `tel:${concierge.phone.replace(/[^+\d]/g, '')}` : null;
---

<Base
  title="Bainbridge Island Visitor Help — PNW Historical Explorer"
  description="Personalized Bainbridge Island trip help by phone, with text-message follow-up containing destination photos, directions, and useful links."
>
  <section class="concierge-hero">
    <div class="container concierge-hero-grid">
      <div>
        <p class="eyebrow">Planning a Bainbridge Island visit?</p>
        <h1>Talk through the day with the Bainbridge Concierge.</h1>
        <p class="lead">{concierge.description}</p>
        <div class="actions">
          {callHref ? (
            <a class="btn" href={callHref}>☎ Call {concierge.phone}</a>
          ) : (
            <span class="btn disabled" aria-disabled="true">Phone service unavailable</span>
          )}
          <a class="btn secondary" href={href('/map')}>Browse places first</a>
        </div>
      </div>
      <div class="phone-card" aria-label="How the concierge works">
        <span class="phone-icon" aria-hidden="true">☎</span>
        <h2>Call, describe your day, and receive the useful links.</h2>
        <ol>
          <li>Share what you enjoy, how much time you have, and where you plan to start.</li>
          <li>Discuss historic places, parks, restaurants, and local businesses that fit the visit.</li>
          <li>Receive a text with photos, destination pages, and direction links.</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container concierge-grid">
      <article class="concierge-panel">
        <p class="eyebrow">Questions the concierge can help with</p>
        <h2>Plan around the day you actually have</h2>
        <div class="prompt-grid">
          <blockquote>“I have two hours before the ferry. What should I see?”</blockquote>
          <blockquote>“Suggest a quiet lunch near Winslow with outdoor seating.”</blockquote>
          <blockquote>“What historic place is nearby and easy to walk?”</blockquote>
          <blockquote>“Build a rainy-day plan for two adults and a child.”</blockquote>
        </div>
      </article>

      <aside class="concierge-panel current-info">
        <p class="eyebrow">Before you rely on the details</p>
        <h2>Business information changes</h2>
        <p>{concierge.serviceNote}</p>
        <ul class="check-list">
          <li>Business hours are reviewed monthly</li>
          <li>Texts can include images, directions, and destination pages</li>
          <li>Suggestions can reflect available time and stated interests</li>
          <li>Restaurant calls and reservation requests are not yet advertised as active services</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section island-callout">
    <div class="container">
      <p class="eyebrow">Explore independently</p>
      <h2>Prefer to browse first?</h2>
      <p>Open the map, choose a destination, and use the visitor guide on each location page. Call when you want help narrowing the choices or adapting the rest of the day.</p>
      <a class="btn" href={href('/map')}>Find a place to visit</a>
    </div>
  </section>
</Base>
