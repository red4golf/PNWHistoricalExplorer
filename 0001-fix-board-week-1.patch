       url: ${{ steps.deployment.outputs.page_url }}
@@ -39,3 +44,22 @@ jobs:
       - name: Deploy
         id: deployment
         uses: actions/deploy-pages@v4
+
+  # Fails the run if the deployed site is missing something it must have.
+  # Two build-config failures reached production unnoticed before this existed
+  # (the search index was never generated; the affiliate tag was empty), which
+  # is what a post-deploy check is for.
+  smoke:
+    needs: deploy
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+      - name: Set up Node
+        uses: actions/setup-node@v4
+        with:
+          node-version: 22
+      - name: Wait for the CDN to pick up the new deploy
+        run: sleep 30
+      - name: Smoke test the live site
+        run: node scripts/smoke.mjs "${{ needs.deploy.outputs.page_url || 'https://red4golf.github.io/PNWHistoricalExplorer' }}"
